<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModernRegedit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ModernRegedit.ViewModels"
    Title="ModernRegedit">

    <Grid ColumnSpacing="8" RowSpacing="4" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Row="0"
            Grid.ColumnSpan="2"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <AppBarButton
                Grid.Column="0"
                Icon="Back"
                Label="Back"
                IsCompact="True"
                IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                ToolTipService.ToolTip="Back (Alt+Left)"
                Click="OnBackClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Left" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>

            <AppBarButton
                Grid.Column="1"
                Icon="Forward"
                Label="Forward"
                IsCompact="True"
                IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                ToolTipService.ToolTip="Forward (Alt+Right)"
                Click="OnForwardClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Right" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>

            <AppBarButton
                Grid.Column="2"
                Icon="Up"
                Label="Up"
                IsCompact="True"
                ToolTipService.ToolTip="Up one level (Alt+Up)"
                Click="OnUpClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Up" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>

            <TextBox
                x:Name="AddressBar"
                Grid.Column="3"
                PlaceholderText="Type a key path, e.g. HKLM\SOFTWARE\Microsoft"
                Text="{x:Bind ViewModel.AddressText, Mode=TwoWay}"
                KeyDown="OnAddressKeyDown" />
        </Grid>

        <TreeView
            x:Name="KeyTree"
            Grid.Row="1"
            Grid.Column="0"
            ItemsSource="{x:Bind ViewModel.Roots}"
            Expanding="OnExpanding"
            SelectionChanged="OnSelectionChanged">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:RegistryKeyNode">
                    <TreeViewItem
                        ItemsSource="{x:Bind Children}"
                        HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=TwoWay}"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE8B7;"
                                FontSize="16" />
                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Padding="12,6"
                ColumnSpacing="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="Name"
                    FontWeight="SemiBold" />
                <TextBlock
                    Grid.Column="1"
                    Text="Type"
                    FontWeight="SemiBold" />
                <TextBlock
                    Grid.Column="2"
                    Text="Data"
                    FontWeight="SemiBold" />
            </Grid>

            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Values}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RegistryValueRow">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind Name}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind KindDisplay}"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind DataDisplay}"
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Mono"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="12,4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="4">
            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                FontSize="12"
                TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>

</Window>
