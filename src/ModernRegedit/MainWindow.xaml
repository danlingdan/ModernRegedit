<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModernRegedit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ModernRegedit.ViewModels"
    Title="ModernRegedit">

    <Grid
        x:Name="RootGrid"
        ColumnSpacing="8"
        RowSpacing="4"
        Margin="8">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnUndoAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="OnRedoAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnPaletteAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Row="0"
            Grid.ColumnSpan="2"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <AppBarButton
                Grid.Column="0"
                Icon="Undo"
                Label="Undo"
                IsCompact="True"
                IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                ToolTipService.ToolTip="Undo (Ctrl+Z)"
                Click="OnUndoClick" />

            <AppBarButton
                Grid.Column="1"
                Icon="Redo"
                Label="Redo"
                IsCompact="True"
                IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}"
                ToolTipService.ToolTip="Redo (Ctrl+Y)"
                Click="OnRedoClick" />

            <AppBarButton
                Grid.Column="2"
                Icon="Back"
                Label="Back"
                IsCompact="True"
                IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                ToolTipService.ToolTip="Back (Alt+Left)"
                Click="OnBackClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Left" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>

            <AppBarButton
                Grid.Column="3"
                Icon="Forward"
                Label="Forward"
                IsCompact="True"
                IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                ToolTipService.ToolTip="Forward (Alt+Right)"
                Click="OnForwardClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Right" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>

            <AppBarButton
                Grid.Column="4"
                Icon="Up"
                Label="Up"
                IsCompact="True"
                ToolTipService.ToolTip="Up one level (Alt+Up)"
                Click="OnUpClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Up" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>

            <AppBarButton
                Grid.Column="7"
                x:Name="FavoritesButton"
                AutomationProperties.AutomationId="FavoritesButton"
                Icon="Favorite"
                Label="Favorites"
                IsCompact="True"
                ToolTipService.ToolTip="Favorite keys"
                Click="OnFavoritesClick" />

            <AppBarToggleButton
                Grid.Column="5"
                Label="32-bit"
                ToolTipService.ToolTip="Show the 32-bit registry view"
                Checked="OnViewToggled"
                Unchecked="OnViewToggled" />

            <AppBarButton
                x:Name="ThemeButton"
                Grid.Column="6"
                AutomationProperties.AutomationId="ThemeButton"
                Label="System"
                ToolTipService.ToolTip="Cycle system / light / dark theme"
                Click="OnThemeClick">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" />
                </AppBarButton.Icon>
            </AppBarButton>

            <TextBox
                x:Name="AddressBar"
                Grid.Column="8"
                PlaceholderText="Type a key path, e.g. HKLM\SOFTWARE\Microsoft"
                Text="{x:Bind ViewModel.AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="OnAddressKeyDown" />

            <AppBarButton
                Grid.Column="9"
                Icon="Filter"
                Label="Scope"
                IsCompact="True"
                ToolTipService.ToolTip="Choose where to match">
                <AppBarButton.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="8" Margin="4">
                            <CheckBox Content="Key names" IsChecked="{x:Bind ViewModel.MatchKeyNames, Mode=TwoWay}" />
                            <CheckBox Content="Value names" IsChecked="{x:Bind ViewModel.MatchValueNames, Mode=TwoWay}" />
                            <CheckBox Content="Value data" IsChecked="{x:Bind ViewModel.MatchValueData, Mode=TwoWay}" />
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarButton
                Grid.Column="10"
                AutomationProperties.AutomationId="SettingsButton"
                Icon="Setting"
                Label="Settings"
                IsCompact="True"
                ToolTipService.ToolTip="Settings"
                Click="OnSettingsClick" />

            <TextBox
                x:Name="SearchBox"
                Grid.Column="11"
                Width="240"
                AutomationProperties.AutomationId="SearchBox"
                PlaceholderText="Search keys, values, data"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="OnSearchKeyDown" />
        </Grid>

        <TreeView
            x:Name="KeyTree"
            Grid.Row="1"
            Grid.Column="0"
            ItemsSource="{x:Bind ViewModel.Roots}"
            Expanding="OnExpanding"
            RightTapped="OnTreeRightTapped"
            SelectionChanged="OnSelectionChanged">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:RegistryKeyNode">
                    <TreeViewItem
                        ItemsSource="{x:Bind Children}"
                        HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=TwoWay}"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE8B7;"
                                FontSize="16" />
                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Padding="12,6"
                ColumnSpacing="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="Name"
                    FontWeight="SemiBold" />
                <TextBlock
                    Grid.Column="1"
                    Text="Type"
                    FontWeight="SemiBold" />
                <TextBlock
                    Grid.Column="2"
                    Text="Data"
                    FontWeight="SemiBold" />
            </Grid>

            <ListView
                x:Name="ValuesList"
                AutomationProperties.AutomationId="ValuesList"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Values}"
                SelectedItem="{x:Bind ViewModel.SelectedValueRow, Mode=TwoWay}"
                SelectionMode="Single"
                DoubleTapped="OnValuesDoubleTapped"
                RightTapped="OnValuesRightTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RegistryValueRow">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <SymbolIcon Symbol="{x:Bind KindSymbol}" Foreground="{x:Bind KindBrush}" />
                                <TextBlock
                                    Text="{x:Bind Name}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind KindDisplay}"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind DataDisplay}"
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Mono"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid
                Grid.Row="2"
                Height="220"
                RowSpacing="4"
                Visibility="{x:Bind ViewModel.SearchPanelVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}"
                        VerticalAlignment="Center"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis" />

                    <AppBarButton
                        Grid.Column="1"
                        Icon="Cancel"
                        Label="Cancel"
                        IsCompact="True"
                        ToolTipService.ToolTip="Cancel search (results so far are kept)"
                        Visibility="{x:Bind ViewModel.CancelButtonVisibility, Mode=OneWay}"
                        Click="OnCancelSearch" />

                    <AppBarButton
                        Grid.Column="2"
                        Icon="Clear"
                        Label="Close"
                        IsCompact="True"
                        ToolTipService.ToolTip="Close search results"
                        Visibility="{x:Bind ViewModel.CloseButtonVisibility, Mode=OneWay}"
                        Click="OnCloseSearch" />
                </Grid>

                <ListView
                    x:Name="ResultsList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.SearchResults}"
                    SelectionMode="Single"
                    DoubleTapped="OnResultsDoubleTapped"
                    KeyDown="OnResultsKeyDown">
                    <ListView.Header>
                        <Grid Padding="12,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Path" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Value" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Data" FontWeight="SemiBold" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResultRow">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind KeyPath}"
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ValueName}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind DataPreview}"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="12,4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="4">
            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                FontSize="12"
                TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>

</Window>
