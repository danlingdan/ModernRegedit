<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModernRegedit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ModernRegedit.ViewModels"
    Title="ModernRegedit">

    <Grid
        x:Name="RootGrid"
        ColumnSpacing="8"
        RowSpacing="4"
        AllowDrop="True"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop"
        ActualThemeChanged="OnActualThemeChanged"
        SizeChanged="OnRootSizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnUndoAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="OnRedoAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnPaletteAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnAddressAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="F6" Invoked="OnF6Accelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeColumn" Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  集成式标题栏：Mica 贯通，整行拖拽区（SetTitleBar），无交互控件  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="16"
                Height="16"
                Margin="16,0,10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/Square44x44Logo.targetsize-24.png" />
            <TextBlock
                x:Name="AppTitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="ModernRegedit" />
        </Grid>

        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="16,0,16,4" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AppBarButton x:Uid="Toolbar_Back" Grid.Column="0" Icon="Back" IsCompact="True"
                    IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" Click="OnBackClick">
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="Left" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Uid="Toolbar_Forward" Grid.Column="1" Icon="Forward" IsCompact="True"
                    IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}" Click="OnForwardClick">
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="Right" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Uid="Toolbar_Up" Grid.Column="2" Icon="Up" IsCompact="True" Click="OnUpClick">
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="Up" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <TextBox x:Uid="AddressBar" x:Name="AddressBar" Grid.Column="3" VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnAddressKeyDown" />
                <AppBarButton x:Uid="ScopeButton" Grid.Column="4" Icon="Filter" IsCompact="True">
                    <AppBarButton.Flyout>
                        <Flyout Placement="Bottom"><StackPanel Spacing="8" Margin="4">
                            <CheckBox x:Uid="Scope_KeyNames" IsChecked="{x:Bind ViewModel.MatchKeyNames, Mode=TwoWay}" />
                            <CheckBox x:Uid="Scope_ValueNames" IsChecked="{x:Bind ViewModel.MatchValueNames, Mode=TwoWay}" />
                            <CheckBox x:Uid="Scope_ValueData" IsChecked="{x:Bind ViewModel.MatchValueData, Mode=TwoWay}" />
                        </StackPanel></Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <TextBox x:Uid="SearchBox" x:Name="SearchBox" Grid.Column="5" Width="220" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SearchBox"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKeyDown" />
            </Grid>
            <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
                Background="Transparent" HorizontalContentAlignment="Left">
                <AppBarButton x:Uid="Action_NewKey" Icon="NewFolder" Click="OnNewKeyClick" />
                <AppBarButton x:Uid="Action_NewValue" Icon="Add" Click="OnNewValueClick" />
                <AppBarSeparator />
                <AppBarButton x:Uid="Action_Import" Icon="Download" Click="OnImportClick" />
                <AppBarButton x:Uid="Action_Export" Icon="Upload" Click="OnExportClick" />
                <AppBarButton x:Uid="Action_Refresh" Icon="Refresh" Click="OnRefreshClick" />
                <AppBarSeparator />
                <AppBarButton x:Uid="Toolbar_Undo" Icon="Undo" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" Click="OnUndoClick" />
                <AppBarButton x:Uid="Toolbar_Redo" Icon="Redo" IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}" Click="OnRedoClick" />
                <AppBarSeparator />
                <AppBarToggleButton x:Uid="Toolbar_32Bit" x:Name="View32Toggle" IsEnabled="{x:Bind ViewModel.CanChangeView, Mode=OneWay}"
                    Checked="OnViewToggled" Unchecked="OnViewToggled" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Uid="Toolbar_Favorites" x:Name="FavoritesButton" AutomationProperties.AutomationId="FavoritesButton" Icon="Favorite" Click="OnFavoritesClick" />
                    <AppBarButton x:Uid="Toolbar_Theme" x:Name="ThemeButton" AutomationProperties.AutomationId="ThemeButton" Click="OnThemeClick">
                        <AppBarButton.Icon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Uid="Toolbar_Settings" AutomationProperties.AutomationId="SettingsButton" Icon="Setting" Click="OnSettingsClick" />
                    <AppBarButton x:Uid="Action_Commands" Click="OnCommandsClick">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE945;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <TreeView
            x:Name="KeyTree"
            Grid.Row="2"
            Grid.Column="0"
            Margin="16,0,0,0"
            ItemsSource="{x:Bind ViewModel.Roots}"
            Expanding="OnExpanding"
            RightTapped="OnTreeRightTapped"
            SelectionChanged="OnSelectionChanged"
            KeyDown="OnTreeKeyDown">
            <TreeView.KeyboardAccelerators>
                <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="OnCopyKeyPathAccelerator" />
            </TreeView.KeyboardAccelerators>
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:RegistryKeyNode">
                    <TreeViewItem
                        ItemsSource="{x:Bind Children}"
                        HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=TwoWay}"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE8B7;"
                                FontSize="16" />
                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <Grid
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,16,0"
            RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <InfoBar
                x:Name="ErrorInfoBar"
                Grid.Row="0"
                AutomationProperties.AutomationId="ErrorInfoBar"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <InfoBar
                x:Name="RiskInfoBar"
                Grid.Row="1"
                AutomationProperties.AutomationId="RiskInfoBar"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsRiskOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.RiskMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.RiskSeverity, Mode=OneWay}" />

            <Grid Grid.Row="2" Margin="0,4,0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.ValueSummary, Mode=OneWay}" VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBox x:Uid="ValueFilter" x:Name="ValueFilter" Grid.Column="1" Width="220"
                    AutomationProperties.AutomationId="ValueFilter" KeyDown="OnValueFilterKeyDown"
                    Text="{x:Bind ViewModel.ValueFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid
                Grid.Row="3"
                Padding="12,6"
                ColumnSpacing="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Button x:Uid="Sort_Name" Grid.Column="0" Tag="0" Click="OnSortValuesClick"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,4"
                    Background="Transparent" BorderThickness="0" FontWeight="SemiBold" />
                <Button x:Uid="Sort_Type" Grid.Column="1" Tag="1" Click="OnSortValuesClick"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,4"
                    Background="Transparent" BorderThickness="0" FontWeight="SemiBold" />
                <Button x:Uid="Sort_Data" Grid.Column="2" Tag="2" Click="OnSortValuesClick"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,4"
                    Background="Transparent" BorderThickness="0" FontWeight="SemiBold" />
            </Grid>

            <Grid Grid.Row="4">
                <ListView
                    x:Name="ValuesList"
                    AutomationProperties.AutomationId="ValuesList"
                    ItemsSource="{x:Bind ViewModel.Values}"
                    SelectedItem="{x:Bind ViewModel.SelectedValueRow, Mode=TwoWay}"
                    SelectionMode="Single"
                    DoubleTapped="OnValuesDoubleTapped"
                    RightTapped="OnValuesRightTapped"
                    KeyDown="OnValuesKeyDown">
                    <ListView.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="OnCopyValueDataAccelerator" />
                    </ListView.KeyboardAccelerators>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RegistryValueRow">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <SymbolIcon Symbol="{x:Bind KindSymbol}" Foreground="{x:Bind KindBrush}" />
                                    <TextBlock
                                        Grid.Column="1" Text="{x:Bind Name}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Name}" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind KindDisplay}"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind DataDisplay}"
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind DataDisplay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  空状态引导：键没有任何值时居中提示（不拦截列表交互）  -->
                <StackPanel
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.ValueListEmptyVisibility, Mode=OneWay}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE8B7;"
                        FontSize="28"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.EmptyValuesHint, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="5"
                Height="220"
                RowSpacing="4"
                Visibility="{x:Bind ViewModel.SearchPanelVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}"
                        VerticalAlignment="Center"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis" />

                    <AppBarButton
                        x:Uid="SearchPanel_Cancel"
                        Grid.Column="1"
                        Icon="Cancel"
                        IsCompact="True"
                        Visibility="{x:Bind ViewModel.CancelButtonVisibility, Mode=OneWay}"
                        Click="OnCancelSearch" />

                    <AppBarButton
                        x:Uid="SearchPanel_Close"
                        Grid.Column="2"
                        Icon="Clear"
                        IsCompact="True"
                        Visibility="{x:Bind ViewModel.CloseButtonVisibility, Mode=OneWay}"
                        Click="OnCloseSearch" />
                </Grid>

                <ListView
                    x:Name="ResultsList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.SearchResults}"
                    SelectionMode="Single"
                    DoubleTapped="OnResultsDoubleTapped"
                    KeyDown="OnResultsKeyDown">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Header>
                        <Grid Padding="12,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="Header_Path" Grid.Column="0" FontWeight="SemiBold" />
                            <TextBlock x:Uid="Header_Value" Grid.Column="1" FontWeight="SemiBold" />
                            <TextBlock x:Uid="Header_Data2" Grid.Column="2" FontWeight="SemiBold" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResultRow">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind KeyPath}"
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ValueDisplay}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind DataPreview}"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Border
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Margin="16,0,16,8"
            Padding="12,4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoadingValues, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.LoadingRingVisibility, Mode=OneWay}" />
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>

</Window>
